# Optional assistant configuration. Map and direct SUMO jobs work without AI.
LLM_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Blank uses the existing provider default; select a tool-capable model.
LLM_MODEL=
MULTI_AGENT_MODE=true

# Optional PUBLIC Mapbox browser token (pk.). Blank uses MapLibre + OSM.
# Private Mapbox tokens are rejected and never rendered into HTML.
MAPBOX_TOKEN=

# SUMO installation root, e.g. C:\Program Files (x86)\SUMO on Windows.
# Its bin directory contains sumo.exe (Windows) or sumo. PATH also works.
SUMO_HOME=

# Optional workspace root; both UI and MCP use <root>/output.
# AGENTSUMO_MCP_OUTPUT_BASE=C:\path\to\workspace
